# Maintainer notes stay in the working dir only — never in the repo.
.dev/

# Developer working-copy marker (systema/updater/service.py DEV_MARKER). Its
# presence is what disables auto-update in a dev checkout, so it must never
# reach a shipped one.
.dev-copy

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# data/ is USER STATE — sessions, memories, tasks, logs, the security audit
# trail. None of it is ever mirrored into the repo. This used to list only the
# two token counters, so anything ELSE the app wrote while the suite ran inside
# the repo copy was still catchable by `git add -A` — data/security/audit.jsonl
# reached a commit that way. Ignore the whole directory instead of naming files
# one incident at a time.
#
# The shipped task templates under data/tasks/ are ALREADY TRACKED and stay
# that way — .gitignore does not untrack files. Anything genuinely new that
# belongs in the repo under data/ needs an explicit `git add -f`.
data/
